{#
| Variable                 | Type     | Description                                  |
|--------------------------|----------|----------------------------------------------|
| component.image          | ?string  | Background image                             |
| component.eyebrow        | ?string  |                                              |
| component.title          | string   |                                              |
| component.description    | ?string  |                                              |
| component.end_date       | ?string  | YYYY-MM-DD, countdown target (end of day)    |
| component.button_text    | ?string  |                                              |
| component.button_url     | ?string  |                                              |
#}
<section component-id="{{ componentId }}" data-testid="hareer-offer" class="s-block hr-offer">
    <div class="container">
        {% set offer_bg = component.image ?: ('images/hareer/offer.jpg'|asset) %}
        <div class="hr-offer__card" style="--hr-offer-bg: url('{{ offer_bg }}')">
            <div class="hr-offer__copy">
                {% if component.eyebrow %}<p class="hr-eyebrow">{{ component.eyebrow }}</p>{% endif %}
                <h2 class="hr-offer__title">{{ component.title }}</h2>
                {% if component.description %}<p class="hr-offer__text">{{ component.description }}</p>{% endif %}
                {% if component.button_text and component.button_url %}
                    <a href="{{ component.button_url }}" class="hr-btn hr-btn--light">{{ component.button_text }}</a>
                {% endif %}
            </div>
            {% if component.end_date %}
                <div class="hr-countdown" data-end="{{ component.end_date|trim }}" aria-live="off">
                    {% for unit in ['days', 'hours', 'minutes', 'seconds'] %}
                        <div class="hr-countdown__unit">
                            <span class="hr-countdown__num" data-unit="{{ unit }}">00</span>
                            <span class="hr-countdown__label">{{ trans('blocks.hareer.' ~ unit) }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</section>
