{#
| Variable                    | Type     | Description                              |
|-----------------------------|----------|------------------------------------------|
| component.title             | ?string  |                                          |
| component.subtitle          | ?string  |                                          |
| component.mosaic            | bool     | Editorial mosaic layout instead of grid  |
| component.items             | object[] |                                          |
| component.items[].image     | string   |                                          |
| component.items[].title     | string   |                                          |
| component.items[].label     | ?string  | e.g. "New season"                        |
| component.items[].url       | string   |                                          |
#}
{% set items = component.items|default([]) %}
<section component-id="{{ componentId }}" data-testid="hareer-collections" class="s-block hr-collections">
    <div class="container">
        {% if component.title or component.subtitle %}
            <header class="hr-section-head">
                {% if component.subtitle %}<p class="hr-eyebrow">{{ component.subtitle }}</p>{% endif %}
                {% if component.title %}<h2 class="hr-section-title">{{ component.title }}</h2>{% endif %}
            </header>
        {% endif %}
        <div class="hr-collections__grid {{ component.mosaic ? 'hr-collections__grid--mosaic' : '' }} count-{{ items|length }}">
            {% for item in items %}
                {% set img = item.image ?: ('images/hareer/cat-' ~ ((loop.index0 % 4) + 1) ~ '.jpg')|asset %}
                <a href="{{ item.url ?: '#' }}" class="hr-collection-card">
                    <span class="hr-collection-card__media">
                        <img src="{{ img }}" alt="{{ item.title|e('html_attr') }}" loading="lazy" width="900" height="1200">
                    </span>
                    <span class="hr-collection-card__body">
                        {% if item.label %}<span class="hr-collection-card__label">{{ item.label }}</span>{% endif %}
                        <span class="hr-collection-card__title">{{ item.title }}</span>
                        <span class="hr-link">{{ trans('blocks.hareer.shop_now') }} <i class="sicon-arrow-left ltr:rotate-180" aria-hidden="true"></i></span>
                    </span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
