{#
| Variable                 | Type     | Description                      |
|--------------------------|----------|----------------------------------|
| component.title          | ?string  | e.g. "@yourstore"                |
| component.subtitle       | ?string  |                                  |
| component.profile_url    | ?string  | Link for the title and photos    |
| component.photos         | object[] |                                  |
| component.photos[].image | string   |                                  |
| component.photos[].url   | ?string  | Overrides the profile link       |
#}
{% set photos = component.photos|default([]) %}
{% if photos|length == 0 %}
    {% set photos = [] %}
    {% for i in 1..6 %}{% set photos = photos|merge([{'image': ('images/hareer/gallery-' ~ i ~ '.jpg')|asset}]) %}{% endfor %}
{% endif %}
<section component-id="{{ componentId }}" data-testid="hareer-gallery" class="s-block hr-gallery">
    <div class="container">
        <header class="hr-section-head">
            {% if component.subtitle %}<p class="hr-eyebrow">{{ component.subtitle }}</p>{% endif %}
            {% if component.title %}
                <h2 class="hr-section-title">
                    {% if component.profile_url %}<a href="{{ component.profile_url }}" target="_blank" rel="noopener">{{ component.title }}</a>{% else %}{{ component.title }}{% endif %}
                </h2>
            {% endif %}
        </header>
    </div>
    <ul class="hr-gallery__grid">
        {% for photo in photos %}
            {% set link = photo.url ?: component.profile_url %}
            <li class="hr-gallery__item">
                {% if link %}<a href="{{ link }}" target="_blank" rel="noopener" aria-label="{{ component.title|default('gallery')|e('html_attr') }} {{ loop.index }}">{% endif %}
                    <img src="{{ photo.image }}" alt="" loading="lazy" width="600" height="600">
                    <span class="hr-gallery__overlay" aria-hidden="true"><i class="sicon-instagram"></i></span>
                {% if link %}</a>{% endif %}
            </li>
        {% endfor %}
    </ul>
</section>
