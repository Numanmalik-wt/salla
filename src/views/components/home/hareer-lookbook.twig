{#
| Variable                       | Type       | Description                                    |
|--------------------------------|------------|------------------------------------------------|
| component.image                | string     | Lookbook photo                                 |
| component.title                | ?string    |                                                |
| component.description          | ?string    |                                                |
| component.products             | Product[]  | Products shown beside the photo                |
| component.points               | object[]   | Hotspots placed on the photo                   |
| component.points[].x           | int        | 0-100, distance from the left edge in percent  |
| component.points[].y           | int        | 0-100, distance from the top edge in percent   |
| component.points[].label       | ?string    |                                                |
| component.points[].url         | ?string    |                                                |
#}
{% set img = component.image ?: ('images/hareer/lookbook.jpg'|asset) %}
<section component-id="{{ componentId }}" data-testid="hareer-lookbook" class="s-block hr-lookbook">
    <div class="container hr-lookbook__inner">
        <figure class="hr-lookbook__media">
            <img src="{{ img }}" alt="{{ component.title|default('lookbook')|e('html_attr') }}" loading="lazy" width="1400" height="1000">
            {% for point in component.points|default([]) %}
                {% set px = point.x|default(50) %}{% set py = point.y|default(50) %}
                <a href="{{ point.url ?: '#' }}" class="hr-hotspot" style="--x: {{ px }}%; --y: {{ py }}%;"
                   aria-label="{{ point.label|default(trans('blocks.hareer.shop_now'))|e('html_attr') }}">
                    <span class="hr-hotspot__dot" aria-hidden="true"></span>
                    {% if point.label %}<span class="hr-hotspot__tip">{{ point.label }}</span>{% endif %}
                </a>
            {% endfor %}
        </figure>
        <div class="hr-lookbook__side">
            <p class="hr-eyebrow">{{ trans('blocks.hareer.shop_the_look') }}</p>
            {% if component.title %}<h2 class="hr-section-title">{{ component.title }}</h2>{% endif %}
            {% if component.description %}<p class="hr-lookbook__text">{{ component.description }}</p>{% endif %}
            {% if component.products|length %}
                <salla-products-list source="selected" limit="{{ component.products|length }}"
                    source-value="[{{ component.products|map((p) => p.id)|join(',') }}]"
                    horizontal-cards class="hr-lookbook__list"></salla-products-list>
            {% endif %}
        </div>
    </div>
</section>
