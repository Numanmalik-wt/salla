{#
| Variable                 | Type     | Description            |
|--------------------------|----------|------------------------|
| component.items          | object[] |                        |
| component.items[].icon   | string   | Salla icon class       |
| component.items[].title  | string   |                        |
| component.items[].text   | ?string  |                        |
#}
{% set items = component.items|default([]) %}
<section component-id="{{ componentId }}" data-testid="hareer-services" class="s-block hr-services">
    <div class="container">
        <ul class="hr-services__grid count-{{ items|length }}">
            {% for item in items %}
                <li class="hr-service">
                    <i class="{{ item.icon ?: 'sicon-shipping-fast' }} hr-service__icon" aria-hidden="true"></i>
                    <div>
                        <h3 class="hr-service__title">{{ item.title }}</h3>
                        {% if item.text %}<p class="hr-service__text">{{ item.text }}</p>{% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
