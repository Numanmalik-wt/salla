{#
  Hareer product extras: abaya length guide, tailoring request and delivery notes.
  All parts are controlled from the theme settings.
#}
{% set show_guide = theme.settings.get('hareer_size_guide', true) %}
{% set guide_image = theme.settings.get('hareer_size_guide_image') %}
{% set whatsapp = store.contacts.whatsapp ?: store.social.whatsapp %}
{% set show_tailoring = theme.settings.get('hareer_tailoring_button', true) and whatsapp %}
{% set delivery_note = theme.settings.get('hareer_delivery_note') %}
{% set returns_note = theme.settings.get('hareer_returns_note') %}

{% if show_guide or show_tailoring %}
    <div class="hr-product-tools">
        {% if show_guide %}
            <button type="button" class="hr-tool-link" onclick="document.getElementById('hr-size-guide').open()" aria-haspopup="dialog">
                <i class="sicon-ruler" aria-hidden="true"></i> {{ trans('blocks.hareer.size_guide') }}
            </button>
        {% endif %}
        {% if show_tailoring %}
            {% set wa_number = whatsapp|replace({'+': '', ' ': '', 'https://wa.me/': '', 'https://api.whatsapp.com/send?phone=': ''}) %}
            <a class="hr-tool-link" target="_blank" rel="noopener"
               href="https://wa.me/{{ wa_number }}?text={{ (trans('blocks.hareer.tailoring_message') ~ ' ' ~ product.name ~ ' ' ~ product.url)|url_encode }}">
                <i class="sicon-whatsapp" aria-hidden="true"></i> {{ trans('blocks.hareer.custom_tailoring') }}
            </a>
        {% endif %}
    </div>
{% endif %}

{% if show_guide %}
    <salla-modal id="hr-size-guide" modal-title="{{ trans('blocks.hareer.size_guide') }}" width="md">
        <div class="hr-size-guide">
            {% if guide_image %}
                <img src="{{ guide_image }}" alt="{{ trans('blocks.hareer.size_guide') }}" loading="lazy" class="w-full rounded">
            {% else %}
                <p class="hr-size-guide__intro">{{ trans('blocks.hareer.size_guide_intro') }}</p>
                <div class="hr-size-guide__table-wrap">
                    <table class="hr-size-guide__table">
                        <thead>
                            <tr>
                                <th scope="col">{{ trans('blocks.hareer.abaya_length') }}</th>
                                <th scope="col">{{ trans('blocks.hareer.your_height') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in [['50', '145 – 150'], ['52', '150 – 155'], ['54', '155 – 160'], ['56', '160 – 165'], ['58', '165 – 170'], ['60', '170 – 175'], ['62', '175 – 180']] %}
                                <tr><td>{{ row[0] }}</td><td>{{ row[1] }} {{ trans('blocks.hareer.cm') }}</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <p class="hr-size-guide__tip">{{ trans('blocks.hareer.size_guide_tip') }}</p>
            {% endif %}
        </div>
    </salla-modal>
{% endif %}

{% if delivery_note or returns_note %}
    <div class="hr-assurance">
        {% if delivery_note %}
            <details class="hr-accordion" open>
                <summary><i class="sicon-shipping-fast" aria-hidden="true"></i> {{ trans('blocks.hareer.delivery') }}</summary>
                <p>{{ delivery_note|nl2br }}</p>
            </details>
        {% endif %}
        {% if returns_note %}
            <details class="hr-accordion">
                <summary><i class="sicon-rotate" aria-hidden="true"></i> {{ trans('blocks.hareer.returns') }}</summary>
                <p>{{ returns_note|nl2br }}</p>
            </details>
        {% endif %}
    </div>
{% endif %}
